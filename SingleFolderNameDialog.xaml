<Window x:Class="ArchiveHelper.SingleFolderNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Single zip" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#161616" Foreground="#FFFFFF" FontFamily="Segoe UI" FontSize="13"
        ContentRendered="Window_ContentRendered">
    <StackPanel Margin="20">
        <Label Content="Zip name" Target="{Binding ElementName=txtFolderName}"
               Foreground="#EEEEEE" Padding="0" Margin="0,0,0,8"/>
        <TextBox x:Name="txtFolderName" Padding="8,6" Background="#242424"
                 Foreground="#FFFFFF" BorderBrush="#4A4A4A" SelectionBrush="#007ACC"
                 TextChanged="FolderName_TextChanged"/>
        <TextBlock x:Name="txtValidation" Foreground="#FF8585" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Create zip" IsDefault="True" Click="CreateZip_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
